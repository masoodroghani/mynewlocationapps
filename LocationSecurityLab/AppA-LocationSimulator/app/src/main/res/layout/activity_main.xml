<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Location Test Simulator" android:textSize="24sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Start latitude / longitude" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"/>
<EditText android:id="@+id/startLat" android:text="34.6720" android:inputType="numberDecimal|numberSigned" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/startLon" android:text="71.7640" android:inputType="numberDecimal|numberSigned" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Destination latitude / longitude" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
<EditText android:id="@+id/endLat" android:text="34.6800" android:inputType="numberDecimal|numberSigned" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/endLon" android:text="71.7800" android:inputType="numberDecimal|numberSigned" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Duration (seconds)" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<EditText android:id="@+id/duration" android:text="120" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Accuracy (meters)" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<EditText android:id="@+id/accuracy" android:text="5" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/startStatic" android:text="Start Static Location" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/startRoute" android:text="Start A → B Simulation" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/stop" android:text="Stop" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="Status: idle" android:textSize="16sp" android:paddingTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
